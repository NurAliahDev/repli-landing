---
import Icon from "./Icon.astro";

/**
 * The "what comes next" card at the foot of a product or industry page, with
 * a quieter link back to the full index under it.
 */
interface Props {
  /** Names the section for assistive tech, e.g. "Continue the tour". */
  label: string;
  href: string;
  num: string;
  title: string;
  text: string;
  all: { label: string; href: string };
}

const { label, href, num, title, text, all } = Astro.props;
---

<section class="section-sm" aria-label={label}>
  <div class="wrap">
    <a class="nextcard" href={href}>
      <span class="nextcard__label mono">Next · {num}</span>
      <span class="nextcard__title">{title}</span>
      <span class="nextcard__text">{text}</span>
      <span class="nextcard__go" aria-hidden="true">
        <Icon name="arrowRight" size={18} />
      </span>
    </a>
    <p class="nextcard__all">
      <a class="arrow-link" href={all.href}>
        {all.label}
        <Icon name="arrowRight" size={15} />
      </a>
    </p>
  </div>
</section>

<style>
  /* A violet wash rather than an ink slab, so the card reads as the next step
     without becoming the darkest thing on the page. Text holds AA on the tint:
     --ink-70 6.69:1, --brand 5.01:1. */
  .nextcard {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--brand-tint);
    color: var(--ink);
    border: 1px solid var(--brand-tint-2);
    border-radius: var(--r-3);
    transition:
      border-color var(--fast) var(--ease),
      box-shadow var(--fast) var(--ease);
  }

  .nextcard:hover {
    border-color: var(--brand);
    box-shadow: var(--shadow-2);
  }

  .nextcard__label {
    grid-column: 1;
    font-size: var(--t-mono-sm);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--brand);
  }

  .nextcard__title {
    grid-column: 1;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    font-weight: 800;
    letter-spacing: var(--track-tight);
  }

  .nextcard__text {
    grid-column: 1;
    margin-top: 0.2rem;
    max-width: 46ch;
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--ink-70);
  }

  /* `span 3`, not `1 / -1`: the rows are implicit, so -1 would stop after the
     first one and pin the chip to the label instead of centring it. */
  .nextcard__go {
    grid-column: 2;
    grid-row: 1 / span 3;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--r-pill);
    background: var(--surface);
    border: 1px solid var(--brand-tint-2);
    color: var(--brand);
    transition:
      transform var(--base) var(--ease),
      background var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .nextcard:hover .nextcard__go {
    transform: translateX(4px);
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }

  .nextcard__all {
    margin-top: 1.5rem;
  }

  @media (max-width: 560px) {
    .nextcard__go {
      display: none;
    }
  }
</style>
