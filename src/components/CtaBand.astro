---
import Icon from "./Icon.astro";
import { cta, contact } from "../lib/site";

interface Props {
  kicker?: string;
  title?: string;
  text?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  note?: string;
  /** Shows the WhatsApp / email line under the buttons. */
  showContact?: boolean;
}

const {
  kicker = "Next step",
  title = "Ready to see it on your own inbox?",
  text = "Thirty minutes, your real WhatsApp traffic, no slide deck. We will tell you honestly whether Replai is the right fit.",
  primary = cta.primary,
  secondary = cta.secondary,
  note = cta.note,
  showContact = true,
} = Astro.props;
---

<section class="cta-band on-ink blueprint">
  <div class="wrap cta-band__inner">
    <div class="cta-band__copy" data-reveal>
      <p class="stamp stamp--brand">
        <span class="dot dot--pulse"></span>
        {kicker}
      </p>
      <h2 class="cta-band__title">{title}</h2>
      <p class="cta-band__text">{text}</p>
    </div>

    <div class="cta-band__side" data-reveal style="--reveal-delay:90ms">
      <div class="cta-band__actions">
        <a href={primary.href} class="btn btn--light btn--lg">
          {primary.label}
          <Icon name="arrowRight" size={17} />
        </a>
        <a href={secondary.href} class="btn btn--ghost-ink btn--lg">{secondary.label}</a>
      </div>

      {note && <p class="cta-band__note">{note}</p>}

      {
        showContact && (
          <ul class="cta-band__contact">
            <li>
              <a href={`mailto:${contact.salesEmail}`}>
                <Icon name="mail" size={15} />
                {contact.salesEmail}
              </a>
            </li>
            <li>
              <span>
                <Icon name="clock" size={15} />
                {contact.hours}
              </span>
            </li>
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  /* The band wears the brand banner: the gradient from the artwork, white type
     on top. Every child that would take a dark-surface tint goes white
     instead — the lavender --signal disappears against the gradient. */
  .cta-band {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
    background: var(--brand-gradient);
    color: #fff;
  }

  .cta-band .stamp--brand {
    color: #fff;
  }

  .cta-band .dot {
    background: #fff;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.24);
  }

  /* --signal is ~2:1 on the lavender end; white keeps the ring above 3:1. */
  .cta-band :focus-visible {
    outline-color: #fff;
  }

  .cta-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }

  .cta-band__title {
    margin-top: 1.1rem;
    font-size: var(--t-h2);
    max-width: 20ch;
    text-wrap: balance;
  }

  .cta-band__text {
    margin-top: 1rem;
    max-width: 40ch;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: #fff;
  }

  /* The side column lands on the lavender end, where white is only 4.05:1 —
     fine for the title, short of AA for the small note and contact lines.
     An ink scrim under the column lifts the worst case to 5.06:1 without
     touching the gradient itself. */
  .cta-band__side {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: rgba(27, 31, 35, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-3);
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .cta-band__note {
    max-width: 38ch;
    font-size: var(--t-xs);
    line-height: 1.6;
    color: #fff;
  }

  .cta-band__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    width: 100%;
    list-style: none;
  }

  .cta-band__contact a,
  .cta-band__contact span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.04em;
    color: #fff;
    transition: color var(--fast) var(--ease);
  }

  /* One tappable link in the rail, so it gets the full 44px. See tokens.css. */
  @media (pointer: coarse) {
    .cta-band__contact a {
      min-height: 44px;
    }
  }

  .cta-band__contact svg {
    color: #fff;
  }

  .cta-band__contact a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1000px) {
    .cta-band__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .cta-band__title {
      max-width: 24ch;
    }
  }
</style>
