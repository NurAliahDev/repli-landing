---
/* A specimen sheet, not twelve floating cards: the tiles share a 1px lattice
   so the whole block reads as one table of configurations. */
import Icon from "../Icon.astro";
import { industries } from "../../lib/solutions";
---

<ul class="igrid">
  {
    industries.map((industry) => (
      <li class="igrid__cell">
        <a class="igrid__link" href={`/solutions/${industry.slug}`}>
          <span class="igrid__top">
            <span class="igrid__icon">
              <Icon name={industry.icon} size={19} />
            </span>
            <span class="igrid__num mono">{industry.num}</span>
          </span>

          <span class="igrid__name">{industry.name}</span>
          <span class="igrid__sum">{industry.summary}</span>

          <span class="igrid__foot">
            <span class="igrid__metric mono">
              <em>{industry.metrics[0].value}</em>
              {industry.metrics[0].label}
            </span>
            <Icon name="arrowRight" size={15} class="igrid__go" />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .igrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* The gap is the rule. Cells paint over a rule-coloured background, so
       every internal border is exactly one hairline and never doubles. */
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    overflow: hidden;
    list-style: none;
  }

  .igrid__cell {
    background: var(--surface);
  }

  .igrid__link {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.55rem;
    height: 100%;
    padding: clamp(1rem, 0.85rem + 0.5vw, 1.35rem);
    transition: background var(--fast) var(--ease);
  }

  .igrid__link:hover {
    background: var(--paper-2);
  }

  .igrid__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .igrid__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-2);
    background: var(--brand-tint);
    border: 1px solid var(--brand-tint-2);
    color: var(--brand);
  }

  .igrid__num {
    font-size: var(--t-mono-sm);
    letter-spacing: var(--track-mono);
    color: var(--ink-40);
  }

  .igrid__name {
    font-size: 1.0125rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .igrid__sum {
    font-size: var(--t-xs);
    line-height: 1.6;
    color: var(--ink-70);
  }

  .igrid__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.4rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
  }

  .igrid__metric {
    display: grid;
    font-size: var(--t-mono-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  .igrid__metric em {
    font-style: normal;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }

  .igrid__go {
    flex: 0 0 auto;
    margin-bottom: 0.15rem;
    color: var(--ink-40);
    transition:
      transform var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .igrid__link:hover .igrid__go {
    transform: translateX(3px);
    color: var(--brand);
  }

  /* Two across on tablets: three 17rem tiles need 1000px of container before
     the summaries start wrapping to four lines. */
  @media (max-width: 1000px) {
    .igrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .igrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
