---
/**
 * Repli mark: a square frame left open at the top-right corner, with a
 * solid block set into the gap. Drawn on a 40-unit grid: 6-unit strokes,
 * a 3-unit gap either side of the 13-unit block.
 */
interface Props {
  /** `mark` drops the wordmark, for tight spaces and favicons. */
  variant?: "full" | "mark";
  /** `light` is for use on the ink background: the mark sits on a white plate. */
  tone?: "brand" | "light";
  size?: number;
  class?: string;
}

const { variant = "full", tone = "brand", size = 30, class: className } = Astro.props;

const hasPlate = tone === "light";
/* On the plate the mark keeps the proportions of the app icon: 23 of 32 units,
   centred. Bare, it fills the box. */
const markTransform = hasPlate ? "translate(4.5 4.5) scale(0.575)" : undefined;
const viewBox = hasPlate ? "0 0 32 32" : "0 0 40 40";
---

<span class:list={["logo", className]} data-variant={variant} data-tone={tone}>
  <svg
    width={size}
    height={size}
    viewBox={viewBox}
    aria-hidden="true"
    focusable="false"
    class="logo__mark"
  >
    {hasPlate && <rect width="32" height="32" rx="4.5" fill="#ffffff" />}
    <g transform={markTransform} fill="var(--brand)">
      <path d="M0 0H24V6H6V34H34V16H40V40H0Z" />
      <rect x="27" width="13" height="13" />
    </g>
  </svg>
  {variant === "full" && <span class="logo__word">Repli</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo[data-tone="light"] .logo__mark {
    border-radius: 4.5px;
    box-shadow: 0 1px 2px rgba(10, 12, 14, 0.3);
  }

  .logo__word {
    font-size: 1.185rem;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    padding-bottom: 1px;
  }
</style>
