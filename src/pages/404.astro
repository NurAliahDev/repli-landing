---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../lib/icons";
import { contact } from "../lib/site";

const routes: { label: string; href: string; text: string; icon: IconName }[] = [
  { label: "The product", href: "/product", text: "Five modules, one record of the conversation.", icon: "layers" },
  { label: "Customers", href: "/customers", text: "Who runs their WhatsApp on Ainnect, and what changed.", icon: "users" },
  { label: "Solutions", href: "/solutions", text: "How this is configured for your trade.", icon: "target" },
  { label: "Contact us", href: "/contact", text: "There is no signup button. Start with a call.", icon: "mail" },
];
---

<BaseLayout
  title="Page not found"
  description="That page does not exist on ainnect.site. The product tour, the solutions index and a way to reach a human are all one click away."
  noindex={true}
>
  <section class="nf" aria-labelledby="nf-title">
    <div class="wrap nf__wrap">
      <div class="nf__copy">
        <p class="nf__code mono" aria-hidden="true">HTTP 404</p>
        <h1 id="nf-title" class="nf__title">
          This page was never written, or it moved and we forgot the forwarding note.
        </h1>
        <p class="nf__lead">
          Either way it is our filing, not your typing. Nothing is broken in the product — only the
          address you landed on.
        </p>

        <div class="nf__actions">
          <a class="btn btn--primary" href="/">
            Back to the homepage
            <Icon name="arrowRight" size={16} />
          </a>
          <a class="btn btn--outline" href="/contact">Tell us what you were looking for</a>
        </div>

        <p class="nf__note">
          Or email {contact.salesEmail} — {contact.hours}, answered by a person.
        </p>
      </div>

      <nav class="nf__routes" aria-label="Popular pages">
        <p class="stamp"><span class="stamp__num">→</span> Most likely you wanted</p>
        <ul>
          {
            routes.map((route) => (
              <li>
                <a href={route.href}>
                  <span class="nf__icon">
                    <Icon name={route.icon} size={17} />
                  </span>
                  <span class="nf__routetext">
                    <strong>{route.label}</strong>
                    <span>{route.text}</span>
                  </span>
                  <Icon name="arrowRight" size={15} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(3.5rem, 2.5rem + 6vw, 7rem);
    background:
      var(--grain),
      radial-gradient(120% 90% at 8% 0%, var(--paper-2) 0%, var(--paper) 55%);
  }

  .nf__wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
  }

  .nf__code {
    font-size: var(--t-mono);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--clay);
  }

  .nf__title {
    margin-top: 1rem;
    font-size: var(--t-h2);
    max-width: 24ch;
  }

  .nf__lead {
    margin-top: 1.1rem;
    max-width: 44ch;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--ink-70);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.75rem;
  }

  .nf__note {
    margin-top: 1.25rem;
    font-size: var(--t-xs);
    color: var(--ink-55);
  }

  /* ── Route list ─────────────────────────────────────────────────────── */
  .nf__routes ul {
    margin-top: 1rem;
    list-style: none;
    border-top: 1px solid var(--rule-2);
  }

  .nf__routes a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    padding: 1rem 0.25rem 1rem 0;
    border-bottom: 1px solid var(--rule);
    transition: padding-inline var(--fast) var(--ease);
  }

  .nf__routes a:hover {
    padding-left: 0.4rem;
  }

  .nf__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--r-2);
    background: var(--surface);
    border: 1px solid var(--rule-2);
    color: var(--brand);
    transition:
      background var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .nf__routes a:hover .nf__icon {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--on-ink);
  }

  .nf__routetext {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .nf__routetext strong {
    font-size: var(--t-body);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .nf__routetext span {
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--ink-70);
  }

  .nf__routes a > svg:last-child {
    color: var(--ink-40);
    transition: color var(--fast) var(--ease);
  }

  .nf__routes a:hover > svg:last-child {
    color: var(--brand);
  }

  @media (max-width: 1000px) {
    .nf__wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
