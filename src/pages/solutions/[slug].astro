---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import LedgerRail from "../../components/LedgerRail.astro";
import Icon from "../../components/Icon.astro";
import CtaBand from "../../components/CtaBand.astro";
import { industries } from "../../lib/solutions";
import { features, type Feature } from "../../lib/features";
import { cta } from "../../lib/site";
import { breadcrumbNode } from "../../lib/schema";

export const getStaticPaths = (() =>
  industries.map((industry, index) => ({
    params: { slug: industry.slug },
    props: {
      industry,
      /* Wraps around, so the tour never dead-ends. */
      next: industries[(index + 1) % industries.length],
    },
  }))) satisfies GetStaticPaths;

const { industry, next } = Astro.props;
const trail = [{ label: "Solutions", href: "/solutions" }];

/* The modules that do the work, resolved to their own catalogue entries so the
   names and icons here can never drift from /product. */
const modules = industry.modules
  .map((slug) => features.find((feature) => feature.slug === slug))
  .filter((feature): feature is Feature => feature !== undefined);
---

<BaseLayout
  title={`${industry.name} on WhatsApp`}
  description={industry.summary}
  schema={[breadcrumbNode(trail, industry.name, `/solutions/${industry.slug}`)]}
>
  <PageHero
    num={industry.num}
    kicker={industry.name}
    title={industry.headline}
    lead={industry.lead}
    trail={trail}
    current={industry.name}
    primary={cta.primary}
    secondary={cta.secondary}
  >
    <LedgerRail items={industry.metrics} class="ind__ledger" />
  </PageHero>

  <!-- ── The actual messages ──────────────────────────────────────────── -->
  <section class="section" aria-labelledby="asks-title">
    <div class="wrap asks">
      <div class="asks__copy">
        <SectionHead
          id="asks-title"
          num="01"
          kicker="What lands in this inbox"
          title="The messages, in the words your customers actually use."
          lead="We read design-partner threads before writing a single automation. This is the raw material the AI agent and the scoring model are tuned against."
        />
        <p class="asks__note">
          <Icon name="translate" size={15} />
          <span>
            Kept verbatim, mixed language and all — because that is how the question arrives, and
            what the agent has to understand.
          </span>
        </p>
      </div>

      <div class="thread" data-reveal>
        <div class="thread__bar">
          <span class="thread__wa"><Icon name="whatsapp" size={15} /></span>
          <span class="thread__who mono">Your business number</span>
          <span class="pill pill--live">
            <span class="dot dot--pulse"></span>
            Live
          </span>
        </div>
        <ul class="thread__list">
          {
            industry.asks.map((ask) => (
              <li class="thread__bubble">
                <span lang="id">{ask}</span>
              </li>
            ))
          }
        </ul>
        <p class="thread__foot mono">Unassigned · waiting for a first reply</p>
      </div>
    </div>
  </section>

  <!-- ── Breaks vs plays ──────────────────────────────────────────────── -->
  <section class="section bg-surface" aria-labelledby="fix-title">
    <div class="wrap">
      <SectionHead
        id="fix-title"
        num="02"
        kicker="Before and after"
        title="What breaks today, and what we set up instead."
      />

      <div class="fix">
        <div class="fix__breaks" data-reveal>
          <h3 class="fix__sub">
            <Icon name="alert" size={15} />
            What breaks today
          </h3>
          <ul class="fix__list">
            {industry.breaks.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="fix__plays" data-reveal>
          <h3 class="fix__sub">
            <Icon name="checkCircle" size={15} />
            What we set up instead
          </h3>
          <ol class="steps fix__steps">
            {
              industry.plays.map((play) => (
                <li class="steps__item">
                  {/* `.steps__item` is a two-track grid whose first track holds the
                      counter, so column two has to be a single child. Two loose
                      children put the paragraph back in the counter column, which
                      `auto` then sized to the prose — crushing the title to ~60px. */}
                  <div class="steps__body">
                    <h4>{play.title}</h4>
                    <p>{play.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <p class="proof" data-reveal>
        <span class="proof__label mono">Where this comes from</span>
        <span class="proof__text">{industry.proof}</span>
      </p>
    </div>
  </section>

  <!-- ── Modules doing the work ───────────────────────────────────────── -->
  <section class="section bg-paper-2" aria-labelledby="mods-title">
    <div class="wrap">
      <SectionHead
        id="mods-title"
        num="03"
        kicker="Modules involved"
        title="No bespoke build. These parts, wired for your trade."
        lead="Every configuration on this site draws on the same five modules. This one leans on the following."
      />

      <ul class="mods">
        {
          modules.map((module) => (
            <li data-reveal>
              <a class="card card--lift mods__card" href={`/product/${module.slug}`}>
                <span class="card__icon">
                  <Icon name={module.icon} size={19} />
                </span>
                <span class="mods__num mono">{module.num}</span>
                <h3 class="card__title mods__title">{module.name}</h3>
                <p class="card__text">{module.summary}</p>
                <span class="mods__go arrow-link">
                  Open the module
                  <Icon name="arrowRight" size={15} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Next industry ────────────────────────────────────────────────── -->
  <section class="section-sm" aria-label="Other industries">
    <div class="wrap">
      <a class="nextcard" href={`/solutions/${next.slug}`}>
        <span class="nextcard__label mono">Next · {next.num}</span>
        <span class="nextcard__title">{next.name}</span>
        <span class="nextcard__text">{next.summary}</span>
        <span class="nextcard__go" aria-hidden="true">
          <Icon name="arrowRight" size={18} />
        </span>
      </a>
      <p class="nextcard__all">
        <a class="arrow-link" href="/solutions">
          All {industries.length} industries, side by side
          <Icon name="arrowRight" size={15} />
        </a>
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .ind__ledger {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* ── Asks ───────────────────────────────────────────────────────────── */
  .asks {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }

  .asks__note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.55rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: var(--t-xs);
    line-height: 1.6;
    color: var(--ink-55);
  }

  .asks__note svg {
    margin-top: 0.2rem;
    color: var(--brand);
  }

  /* The thread is a mock, not a screenshot: enough chrome to read as WhatsApp,
     not enough to pretend it is a real capture. */
  .thread {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }

  .thread__bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    background: var(--paper-2);
    border-bottom: 1px solid var(--rule);
  }

  .thread__wa {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: var(--r-pill);
    background: var(--brand);
    color: var(--on-ink);
  }

  .thread__who {
    flex: 1 1 auto;
    font-size: var(--t-mono-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  .thread__list {
    display: grid;
    gap: 0.7rem;
    padding: 1.1rem 1rem;
    list-style: none;
  }

  .thread__bubble {
    justify-self: start;
    max-width: 92%;
    padding: 0.7rem 0.9rem;
    background: var(--paper-3);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    /* One squared corner points the bubble at the sender. */
    border-top-left-radius: 4px;
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* Real threads are ragged, so the widths step rather than lining up. */
  .thread__bubble:nth-child(2) {
    max-width: 84%;
  }

  .thread__bubble:nth-child(3) {
    max-width: 96%;
  }

  .thread__foot {
    padding: 0.7rem 1rem;
    border-top: 1px dashed var(--rule-2);
    font-size: var(--t-mono-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  @media (max-width: 1000px) {
    .asks {
      grid-template-columns: minmax(0, 1fr);
    }

    .thread {
      position: static;
    }
  }

  /* ── Breaks vs plays ────────────────────────────────────────────────── */
  .fix {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    margin-top: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
  }

  .fix__sub {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: 500;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--ink-55);
  }

  .fix__breaks .fix__sub svg {
    color: var(--accent-ink);
  }

  .fix__plays .fix__sub svg {
    color: var(--brand);
  }

  .fix__list {
    display: grid;
    margin-top: 1.1rem;
    list-style: none;
  }

  .fix__list li {
    padding: 0.8rem 0 0.8rem 1rem;
    border-top: 1px solid var(--rule);
    border-left: 2px solid var(--accent-tint);
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-70);
  }

  .fix__list li:first-child {
    border-top: 0;
  }

  .fix__steps {
    margin-top: 1.1rem;
  }

  .fix__steps h4 {
    font-size: var(--t-body);
    letter-spacing: -0.025em;
  }

  .fix__steps p {
    margin-top: 0.35rem;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-70);
  }

  .proof {
    display: grid;
    gap: 0.3rem;
    margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
    padding-left: 1rem;
    border-left: 2px solid var(--rule-3);
  }

  .proof__label {
    font-size: var(--t-mono-sm);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--ink-40);
  }

  .proof__text {
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-70);
  }

  @media (max-width: 1000px) {
    .fix {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── Modules ────────────────────────────────────────────────────────── */
  .mods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(0.9rem, 0.6rem + 1vw, 1.35rem);
    margin-top: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    list-style: none;
  }

  .mods__card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    height: 100%;
  }

  .mods__num {
    margin-top: 0.9rem;
    font-size: var(--t-mono-sm);
    letter-spacing: var(--track-mono);
    color: var(--ink-40);
  }

  .mods__title {
    margin-top: 0.15rem;
  }

  .mods__go {
    margin-top: 1.1rem;
    align-self: end;
  }

  /* The whole card is the link, so the arrow has to answer to the card's
     hover rather than to its own. */
  .mods__card:hover .mods__go {
    background-size: 100% 1.5px;
  }

  .mods__card:hover .mods__go svg {
    transform: translateX(3px);
  }

  /* ── Next card ──────────────────────────────────────────────────────── */
  .nextcard {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--ink);
    color: var(--on-ink);
    border-radius: var(--r-3);
    transition: background var(--fast) var(--ease);
  }

  .nextcard:hover {
    background: var(--ink-2);
  }

  .nextcard__label {
    grid-column: 1;
    font-size: var(--t-mono-sm);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--signal);
  }

  .nextcard__title {
    grid-column: 1;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    font-weight: 800;
    letter-spacing: var(--track-tight);
  }

  .nextcard__text {
    grid-column: 1;
    margin-top: 0.2rem;
    max-width: 46ch;
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--on-ink-70);
  }

  .nextcard__go {
    grid-column: 2;
    grid-row: 1 / -1;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--r-pill);
    border: 1px solid var(--rule-ink-2);
    transition:
      transform var(--base) var(--ease),
      background var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .nextcard:hover .nextcard__go {
    transform: translateX(4px);
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
  }

  .nextcard__all {
    margin-top: 1.5rem;
  }

  @media (max-width: 560px) {
    .nextcard__go {
      display: none;
    }
  }
</style>
